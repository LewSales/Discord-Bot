# ─── Discord ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your-discord-bot-token-here
COMMAND_PREFIX=!

# Moderator Discord user IDs (comma-separated, no spaces)
MOD_IDS=123456789012345678,987654321098765432

# ─── Discord Channels & Webhooks ─────────────────────────────────────────────
VOICE_CHANNEL_ID=your-voice-channel-id
PRICE_CHANNEL_ID=your-price-channel-id
ALERT_CHANNEL_ID=your-alert-channel-id

VOICE_WEBHOOK_URL=https://discord.com/api/webhooks/...
PRICE_WEBHOOK_URL=https://discord.com/api/webhooks/...
GENERAL_WEBHOOK_URL=https://discord.com/api/webhooks/...
ANNOUNCEMENT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ─── Solana ───────────────────────────────────────────────────────────────────
# RPC endpoint — use a dedicated provider (QuickNode, Helius, etc.) for production
RPC_URL=https://api.mainnet-beta.solana.com

# SPL token mint address for your token
WINLEW_MINT=your-token-mint-address-here

# Path to the bot's Solana keypair JSON file (used for faucet/send)
# Generate with: solana-keygen new -o ./bot-keypair.json
# Fund this wallet with SOL for transaction fees
BOT_KEYPAIR_PATH=./bot-keypair.json

# Faucet drip amount per claim (in tokens, not lamports)
DRIP_AMOUNT=1000

# ─── Price Feed Pool/Pair IDs ─────────────────────────────────────────────────
# Find these on each platform's UI for your token's trading pair
GECKO_PAIR_ID=your-geckoterminal-pool-address
RAYDIUM_POOL_ID=your-raydium-pool-address
PUMPFUN_POOL_ID=your-pumpfun-pool-address
DEXSCREENER_PAIR_ID=your-dexscreener-pair-address

# ─── Twitter / X (optional — comment out if not using) ───────────────────────
TWITTER_BEARER_TOKEN=your-twitter-bearer-token-here

# ─── Solscan (optional) ──────────────────────────────────────────────────────
SOLSCAN_API_KEY=your-solscan-api-key-here
